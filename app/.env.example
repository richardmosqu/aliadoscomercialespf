# Copia este archivo como app/.env (no se sube al repositorio). Todo es opcional en local.

# Análisis con IA (botón "Analizar con IA"). Sin clave, el evaluador funciona igual con las preguntas.
# ANTHROPIC_API_KEY=
# AFILIA_MODELO=claude-opus-5-5
# AFILIA_ESFUERZO=medium
# AFILIA_IA=off            # apaga la IA aunque haya clave

# Para abrir la app a la red (servidor): clave de 16 caracteres o más y secreto de sesión largo y aleatorio.
# AFILIA_HOST=0.0.0.0
# AFILIA_CLAVE_ACCESO=
# AFILIA_SECRETO_SESION=
# AFILIA_DOMINIO=paguelofacil.com
# AFILIA_URL_PUBLICA=https://...
# AFILIA_DATOS_DIR=/var/data/datos
